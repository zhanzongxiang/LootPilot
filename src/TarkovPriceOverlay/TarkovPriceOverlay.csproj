<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LootPilot</AssemblyName>
    <RootNamespace>TarkovPriceOverlay</RootNamespace>
    <Product>LootPilot</Product>
    <Description>屏幕物资识别与价格悬浮工具</Description>
    <ApplicationIcon>Assets\LootPilot.ico</ApplicationIcon>
    <Version>0.11.1</Version>
    <AssemblyVersion>0.11.1.0</AssemblyVersion>
    <FileVersion>0.11.1.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RapidOcrNet" Version="3.0.0" />
    <Resource Include="Assets\LootPilot-icon.png" />
    <Content Include="Assets\OcrModels\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>ocr-models\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
