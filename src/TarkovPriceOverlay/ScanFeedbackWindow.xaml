        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Width="132" Height="34" SizeToContent="WidthAndHeight">
  <Border Background="#F00B0D0C" BorderBrush="#8D7B55" BorderThickness="1"
          CornerRadius="0" Padding="9,6">
