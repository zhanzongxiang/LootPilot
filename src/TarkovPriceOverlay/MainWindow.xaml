<Window x:Class="TarkovPriceOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LootPilot" Icon="/Assets/LootPilot-icon.png"
        Height="850" Width="900" MinHeight="620" MinWidth="840"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/><Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource InputBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="ModeChoice" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="ChoiceBorder" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="24,9" Margin="3,0">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ThemeChoice" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="ThemeBorder" Background="{DynamicResource SoftSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="7,5" Margin="2">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ThemeBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter TargetName="ThemeBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="24,15">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Image Source="/Assets/LootPilot-icon.png" Width="52" Height="52" Margin="0,0,14,0"
                 Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="27" FontWeight="SemiBold" Text="LootPilot"/>
            <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="LOOT VALUE SCANNER  ·  SHADEPILOT SERIES"/>
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                CornerRadius="12" Padding="13,7" VerticalAlignment="Center">
          <TextBlock x:Name="ModeBadge" Text="PvP 数据" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24,20,24,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="运行状态" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
              <TextBlock x:Name="StatusText" Text="正在初始化…" Margin="0,7,0,0" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock x:Name="CacheText" Margin="0,7,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              <TextBlock x:Name="NextRefreshText" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="RefreshButton" Content="刷新物价" Click="RefreshButton_Click"
                    Margin="16,0,0,0" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <Border Margin="0,16,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="扫描记录" Padding="11,5" Click="HistoryButton_Click"/>
              <TextBlock Text="快捷扫描" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       Text="按键后会立即在口袋右侧显示扫描反馈。整屏模式会扫描仓库及完整随身物品区域。"/>
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Margin="0,0,6,0" Background="{DynamicResource TintSurfaceBrush}" CornerRadius="7" Padding="14">
                <StackPanel><TextBlock Text="单物品" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="HotkeyRun" Margin="0,5,0,0" FontSize="20" Foreground="{DynamicResource AccentBrush}"/></StackPanel>
              </Border>
              <Border Grid.Column="1" Margin="6,0,0,0" Background="{DynamicResource TintSurfaceBrush}" CornerRadius="7" Padding="14">
                <StackPanel><TextBlock Text="整屏标价" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="InventoryHotkeyRun" Margin="0,5,0,0" FontSize="20" Foreground="{DynamicResource AccentBrush}"/></StackPanel>
              </Border>
            </Grid>
            <TextBlock x:Name="LastResultText" Margin="0,14,0,0" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Margin="0,16,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
          <StackPanel>
            <TextBlock Text="手动物品测试" Foreground="{DynamicResource MutedBrush}"/>
            <DockPanel Margin="0,9,0,0">
              <Button DockPanel.Dock="Right" Content="显示价格" Click="ManualTest_Click" Margin="10,0,0,0"/>
              <TextBox x:Name="ManualInput" Text="显卡"/>
            </DockPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel Margin="14">
          <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Margin="0,6,0,22" Text="设置保存在本机，升级程序不会丢失。" Foreground="{DynamicResource MutedBrush}"/>

          <TextBlock Text="价格数据库" Foreground="{DynamicResource MutedBrush}"/>
          <Grid Margin="-3,7,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <RadioButton x:Name="PvpMode" Style="{StaticResource ModeChoice}" Content="PvP" GroupName="Mode" IsChecked="True"/>
            <RadioButton x:Name="PveMode" Grid.Column="1" Style="{StaticResource ModeChoice}" Content="PvE" GroupName="Mode"/>
            <RadioButton x:Name="SeasonMode" Grid.Column="2" Style="{StaticResource ModeChoice}" Content="赛季服" GroupName="Mode"/>
          </Grid>

          <TextBlock Text="识别性能" Foreground="{DynamicResource MutedBrush}"/>
          <UniformGrid Columns="3" Margin="-2,7,-2,4">
            <RadioButton x:Name="RecognitionFast" Style="{StaticResource ThemeChoice}" Content="极速" GroupName="Recognition" Checked="RecognitionMode_Checked"/>
            <RadioButton x:Name="RecognitionBalanced" Style="{StaticResource ThemeChoice}" Content="平衡" GroupName="Recognition" IsChecked="True" Checked="RecognitionMode_Checked"/>
            <RadioButton x:Name="RecognitionParallel" Style="{StaticResource ThemeChoice}" Content="精确" GroupName="Recognition" Checked="RecognitionMode_Checked"/>
          </UniformGrid>
          <TextBlock Margin="0,0,0,16" Text="极速只跑基础神经识别；平衡按需补扫未命中格；精确会再用双 OCR 确认剩余格。"
                     Foreground="{DynamicResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap"/>

          <TextBlock Text="界面主题" Foreground="{DynamicResource MutedBrush}"/>
          <UniformGrid Columns="3" Margin="-2,7,-2,16">
            <RadioButton x:Name="ThemeMist" Style="{StaticResource ThemeChoice}" Content="雾紫" Tag="雾紫" GroupName="Theme" Checked="ThemeChoice_Checked"/>
            <RadioButton x:Name="ThemeNight" Style="{StaticResource ThemeChoice}" Content="极夜蓝" Tag="极夜蓝" GroupName="Theme" Checked="ThemeChoice_Checked"/>
            <RadioButton x:Name="ThemeMint" Style="{StaticResource ThemeChoice}" Content="薄荷灰" Tag="薄荷灰" GroupName="Theme" Checked="ThemeChoice_Checked"/>
            <RadioButton x:Name="ThemeSand" Style="{StaticResource ThemeChoice}" Content="暖砂" Tag="暖砂" GroupName="Theme" Checked="ThemeChoice_Checked"/>
            <RadioButton x:Name="ThemeMono" Style="{StaticResource ThemeChoice}" Content="黑白极简" Tag="黑白极简" GroupName="Theme" Checked="ThemeChoice_Checked"/>
          </UniformGrid>

          <TextBlock Text="单物品快捷键" Foreground="{DynamicResource MutedBrush}"/>
          <TextBox x:Name="HotkeyInput" Margin="0,7,0,5" PreviewKeyDown="HotkeyInput_PreviewKeyDown"/>
          <TextBlock Text="示例：Alt+Q、Ctrl+Shift+P、NumPad1（可单键）" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>

          <TextBlock Margin="0,18,0,0" Text="整屏扫描快捷键" Foreground="{DynamicResource MutedBrush}"/>
          <TextBox x:Name="InventoryHotkeyInput" Margin="0,7,0,5" PreviewKeyDown="HotkeyInput_PreviewKeyDown"/>
          <TextBlock Text="两个快捷键不能相同" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>

          <TextBlock Margin="0,16,0,0" Text="最低显示价值（卢布）" Foreground="{DynamicResource MutedBrush}"/>
          <TextBox x:Name="MinimumPriceInput" Margin="0,7,0,5" Text="0"/>

          <TextBlock Margin="0,16,0,0" Text="显示适配" Foreground="{DynamicResource MutedBrush}"/>
          <ComboBox x:Name="DisplayScalingModeInput" Margin="0,7,0,7" SelectedValuePath="Tag">
            <ComboBoxItem Content="自动检测" Tag="Auto"/>
            <ComboBoxItem Content="原生 16:9" Tag="Native16x9"/>
            <ComboBoxItem Content="原生 16:10" Tag="Native16x10"/>
            <ComboBoxItem Content="横纵拉伸" Tag="Stretched"/>
          </ComboBox>
          <DockPanel Margin="0,0,0,7">
            <TextBlock Text="游戏 UI 缩放" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            <ComboBox x:Name="GameUiScaleInput" Width="92" Margin="10,0,0,0" SelectedValuePath="Tag">
              <ComboBoxItem Content="80%" Tag="80"/><ComboBoxItem Content="90%" Tag="90"/>
              <ComboBoxItem Content="100%" Tag="100"/><ComboBoxItem Content="110%" Tag="110"/>
              <ComboBoxItem Content="120%" Tag="120"/>
            </ComboBox>
          </DockPanel>
          <CheckBox x:Name="EnableLocalGridCalibration" Content="局部校准真实格线（推荐）"
                    Foreground="{DynamicResource TextBrush}"/>
          <TextBlock Margin="0,5,0,6" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap"
                     Text="自动读取当前屏幕分辨率；局部校准只在预计位置附近修正少量偏移。"/>
          <TextBlock Text="0 表示全部显示；例如 20000 可隐藏低价值角标" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>

          <CheckBox x:Name="FixedOverlayPosition" Margin="0,18,0,0" Content="单物品价格窗口使用固定位置"
                    Foreground="{DynamicResource TextBrush}"/>
          <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="设置窗口位置" Padding="11,6" Click="CaptureOverlayPosition_Click"/>
            <TextBlock x:Name="FixedOverlayPositionText" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
          </DockPanel>
          <TextBlock Margin="0,5,0,0" Text="点击后拖动预览框，放到目标位置并保存。"
                     Foreground="{DynamicResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap"/>

          <Button x:Name="SaveSettingsButton" Margin="0,18,0,0" Content="保存并应用" Click="SaveSettings_Click"/>

          <Border Margin="0,18,0,0" Background="{DynamicResource SoftSurfaceBrush}" CornerRadius="7" Padding="13">
            <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       Text="纯外部屏幕截图识别：不读取游戏内存、不注入 DLL、不 Hook 游戏、不模拟操作。"/>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource SoftSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <DockPanel Margin="24,8">
        <TextBlock DockPanel.Dock="Left" Foreground="{DynamicResource AccentBrush}" FontSize="11"
                   FontWeight="SemiBold" Text="BY XD · 免费分享，倒卖必究"/>
        <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11" TextAlignment="Right"
                   Text="建议使用 1920×1080 无边框窗口或窗口化全屏；独占全屏可能遮挡普通悬浮层。"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
