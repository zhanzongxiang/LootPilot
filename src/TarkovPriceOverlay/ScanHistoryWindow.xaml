<Window x:Class="TarkovPriceOverlay.ScanHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LootPilot · 扫描记录" Icon="/Assets/LootPilot-icon.png"
        Width="560" Height="540" MinWidth="480" MinHeight="420"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="扫描记录" FontSize="24" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" Margin="0,6,0,16" Foreground="{DynamicResource MutedBrush}"
               Text="最近 50 次整屏扫描，仅保存在本机。总价为识别结果的参考合计。"/>
    <Grid Grid.Row="2">
    <TextBlock x:Name="EmptyText" Text="还没有扫描记录" Foreground="{DynamicResource MutedBrush}"
               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
    <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="{Binding TimeText}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding FleaText}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding TraderText}" Foreground="#D2A34C" VerticalAlignment="Center" Margin="18,0,0,0"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    </Grid>
  </Grid>
</Window>
