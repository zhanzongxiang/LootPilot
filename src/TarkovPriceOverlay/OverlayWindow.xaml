<Window x:Class="TarkovPriceOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="348" SizeToContent="Height" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False">
  <Border Background="#F00B0D0C" BorderBrush="#8D7B55" BorderThickness="1"
          CornerRadius="1" SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="4"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border Background="#B99A55"/>
      <Grid Grid.Row="1" Margin="13,9,13,11">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#6D674F" Margin="0,1,0,0"/>
        <StackPanel Grid.Column="1" Margin="10,0,0,0">
          <DockPanel LastChildFill="True">
            <TextBlock Text="[ LOOT INTEL ]" DockPanel.Dock="Right" Foreground="#77766F"
                       FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/>
            <TextBlock x:Name="NameText" FontFamily="Microsoft YaHei UI" FontSize="16"
                       FontWeight="SemiBold" Foreground="#E7E2D5" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <Border Height="1" Background="#393A35" Margin="0,8,0,8"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="1"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="FLEA / 跳蚤" Foreground="#898981" FontFamily="Consolas" FontSize="9"/>
              <TextBlock x:Name="FleaText" FontFamily="Consolas" FontSize="18"
                         FontWeight="Bold" Foreground="#D9BD77" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#383A35"/>
            <StackPanel Grid.Column="2" Margin="12,0,0,0">
              <TextBlock Text="TRADER / 商人" Foreground="#898981" FontFamily="Consolas" FontSize="9"/>
              <TextBlock x:Name="TraderText" FontFamily="Consolas" FontSize="18"
                         FontWeight="Bold" Foreground="#B5B9A2" Margin="0,2,0,0"/>
              <TextBlock x:Name="TraderNameText" Foreground="#777B70" FontSize="9"/>
            </StackPanel>
          </Grid>
          <Border Height="1" Background="#393A35" Margin="0,9,0,7"/>
          <DockPanel LastChildFill="True">
            <TextBlock x:Name="UsageText" DockPanel.Dock="Right" Foreground="#91A07B"
                       FontSize="10" FontWeight="SemiBold"/>
            <TextBlock x:Name="PerSlotText" Foreground="#AAA79C" FontFamily="Consolas" FontSize="10"/>
          </DockPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
